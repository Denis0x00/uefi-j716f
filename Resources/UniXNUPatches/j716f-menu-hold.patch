+  if (!DiagnosticHold && !HasInput && (RotateMs == 0)) {
     RotateMs = DEFAULT_ROTATE_SEC * 1000;
   }
 
@@ -132,7 +141,8 @@ UniXNUMenuRun (
   UniXNUUiDrawStatus (
     Ui,
