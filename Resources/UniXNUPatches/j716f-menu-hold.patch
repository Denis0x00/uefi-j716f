@@ -50,3 +50,14 @@
 
   ## ASCII model name reported by menu plugins that export device files.
   gUniXNUPkgTokenSpaceGuid.PcdUniXNUDeviceModel|"UniXNU"|VOID*|0x00000004
+
+  ## Keep the built-in diagnostic menu still and wait for input. A valid
+  #  external configuration keeps its own timeout and rotation settings.
+  #  Without an input device, the menu retains its fallback timeout.
+  gUniXNUPkgTokenSpaceGuid.PcdUniXNUBuiltinMenuWaitForInput|FALSE|BOOLEAN|0x00000005
+
+  ## Diagnostic firmware only: every menu waits for an explicit selection,
+  #  including loaded configurations and menus with no input device. Polls
+  #  ConIn every 100 ms using Stall; never falls back to automatic selection
+  #  on missing input or a timer/event failure. Normal builds leave FALSE.
+  gUniXNUPkgTokenSpaceGuid.PcdUniXNUDiagnosticMenuHold|FALSE|BOOLEAN|0x00000006
